{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/ai.js": {
      "includeFiles": "server/{ai-http,ai-actions}.mjs",
      "maxDuration": 60
    },
    "api/ai-search.js": {
      "includeFiles": "server/{ai-http,ai-actions}.mjs",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/ai",
      "destination": "/api/ai"
    },
    {
      "source": "/api/ai/stream",
      "destination": "/api/ai?__nazix=/api/ai/stream"
    },
    {
      "source": "/api/ai/image",
      "destination": "/api/ai?__nazix=/api/ai/image"
    },
    {
      "source": "/api/ai-search",
      "destination": "/api/ai?__nazix=/api/ai-search"
    },
    {
      "source": "/search",
      "destination": "/api/ai?__nazix=/api/ai-search"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
