rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Isolation par utilisateur (Auth uid + e-mail).
    // Collez ce fichier dans Firebase Console → Firestore → Règles
    // (firebase deploy --only firestore:rules si la CLI est connectée).
    // Copie des règles test ouvertes jusqu’au 2026-12-04 : firestore.rules.test.md
    //
    // Règles test (NE PAS activer en prod) :
    // match /{document=**} {
    //   allow read, write: if request.time < timestamp.date(2026, 12, 4);
    // }

    function isSignedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function isAdminEmail() {
      return isSignedIn() && authEmail() == 'facultamalika@gmail.com';
    }

    function userPath() {
      return /databases/$(database)/documents/xx_users/$(request.auth.uid);
    }

    function isAdmin() {
      return isAdminEmail()
        || (isSignedIn()
            && exists(userPath())
            && get(userPath()).data.role == 'Administrateur');
    }

    function isSelfUser() {
      return isSignedIn() && (
        resource.id == request.auth.uid
        || resource.data.id == request.auth.uid
        || resource.data.email == authEmail()
      );
    }

    function isSelfUserCreate() {
      return isSignedIn() && (
        request.resource.id == request.auth.uid
        || request.resource.data.id == request.auth.uid
        || request.resource.data.email == authEmail()
      );
    }

    function isSelfByUserId() {
      return isSignedIn() && (
        resource.data.userId == request.auth.uid
        || resource.data.email == authEmail()
      );
    }

    function isSelfByUserIdCreate() {
      return isSignedIn() && (
        request.resource.data.userId == request.auth.uid
        || request.resource.data.email == authEmail()
      );
    }

    function isOwner() {
      return isSignedIn() && (
        resource.data.ownerId == request.auth.uid
        || resource.data.ownerEmail == authEmail()
      );
    }

    function isOwnerCreate() {
      return isSignedIn() && (
        request.resource.data.ownerId == request.auth.uid
        || request.resource.data.ownerEmail == authEmail()
      );
    }

    function isPublic() {
      return resource.data.visibility == 'Publique';
    }

    function isTeamVisible() {
      return resource.data.visibility == 'Équipe'
        || resource.data.inheritedTeam == true;
    }

    function isSharedRead() {
      return isSignedIn() && (
        (resource.data.keys().hasAll(['shareUserIds'])
          && request.auth.uid in resource.data.shareUserIds)
        || (resource.data.keys().hasAll(['shareEmails'])
          && authEmail() in resource.data.shareEmails)
      );
    }

    function isSharedEdit() {
      return isSignedIn() && (
        (resource.data.keys().hasAll(['shareEditUserIds'])
          && request.auth.uid in resource.data.shareEditUserIds)
        || (resource.data.keys().hasAll(['shareEditEmails'])
          && authEmail() in resource.data.shareEditEmails)
      );
    }

    function canReadEntity() {
      return isAdmin() || isOwner() || isPublic() || isSharedRead();
    }

    function canReadFileEntity() {
      return isAdmin() || isOwner() || isTeamVisible() || isPublic() || isSharedRead();
    }

    function isSharedManage() {
      return isSignedIn() && (
        (resource.data.keys().hasAll(['shareManageUserIds'])
          && request.auth.uid in resource.data.shareManageUserIds)
        || (resource.data.keys().hasAll(['shareManageEmails'])
          && authEmail() in resource.data.shareManageEmails)
      );
    }

    function canWriteEntity() {
      return isAdmin() || isOwner() || isSharedEdit();
    }

    function canWriteResource() {
      return isAdmin() || isOwnerCreate() || (
        isSignedIn()
        && request.resource.data.keys().hasAll(['shareEditUserIds'])
        && request.auth.uid in request.resource.data.shareEditUserIds
      );
    }

    function isGroupMember() {
      return isSignedIn()
        && resource.data.keys().hasAll(['memberIds'])
        && request.auth.uid in resource.data.memberIds;
    }

    function isGroupMemberOnWrite() {
      return isSignedIn()
        && request.resource.data.keys().hasAll(['memberIds'])
        && request.auth.uid in request.resource.data.memberIds;
    }

    match /xx_users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSelfUserCreate() || isAdmin();
      allow update, delete: if isSelfUser() || isAdmin();
    }

    match /xx_sessions/{id} {
      allow read, update, delete: if isAdmin() || isSelfByUserId();
      allow create: if isSelfByUserIdCreate() || isAdmin();
    }

    match /xx_notes/{id} {
      allow read: if isSignedIn() && canReadEntity();
      allow create: if isOwnerCreate() || isAdmin();
      allow update, delete: if canWriteEntity();
    }

    match /xx_ideas/{id} {
      allow read: if isSignedIn() && canReadEntity();
      allow create: if isOwnerCreate() || isAdmin();
      allow update, delete: if canWriteEntity()
        || (canReadEntity()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['votes', 'updatedAt', 'history']));
    }

    match /xx_projects/{id} {
      allow read: if isSignedIn() && canReadEntity();
      allow create: if isOwnerCreate() || isAdmin();
      allow update, delete: if canWriteEntity();
    }

    match /xx_events/{id} {
      allow read: if isSignedIn() && canReadEntity();
      allow create: if isOwnerCreate() || isAdmin();
      allow update, delete: if canWriteEntity();
    }

    match /xx_notifications/{id} {
      allow read, update, delete: if isAdmin() || isSelfByUserId();
      allow create: if isSignedIn() && request.resource.data.keys().hasAll(['userId']);
    }

    // Réinitialisation hors session : création seule. Pas de lecture client.
    match /xx_reset_tokens/{id} {
      allow create: if true;
      allow update: if request.resource.data.used == true
        && request.resource.data.token == resource.data.token;
      allow read, delete: if isAdmin();
    }

    match /xx_groups/{id} {
      allow read: if isAdmin()
        || isGroupMember()
        || (isSignedIn() && resource.data.isGeneral == true);
      allow create: if isSignedIn() && isOwnerCreate() && isGroupMemberOnWrite();
      allow update: if isAdmin() || isOwner() || isGroupMember();
      allow delete: if isAdmin() || isOwner();
    }

    match /xx_folders/{id} {
      allow read: if isSignedIn() && canReadFileEntity();
      allow create: if isOwnerCreate() || isAdmin();
      allow update: if canWriteEntity();
      allow delete: if isAdmin() || isOwner() || isSharedManage();
    }

    match /xx_files/{id} {
      allow read: if isSignedIn() && canReadFileEntity();
      allow create: if isOwnerCreate() || isAdmin();
      allow update: if canWriteEntity();
      allow delete: if isAdmin() || isOwner() || isSharedManage();
    }

    match /xx_budgets/{id} {
      allow read: if isSignedIn() && (canReadEntity() || isTeamVisible());
      allow create: if isOwnerCreate() || isAdmin();
      allow update, delete: if canWriteEntity();
    }

    match /xx_budget_lines/{id} {
      allow read: if isSignedIn() && (canReadEntity() || isTeamVisible());
      allow create: if canWriteResource();
      allow update, delete: if canWriteEntity();
    }

    match /xx_risks/{id} {
      allow read: if isSignedIn() && (canReadEntity() || isTeamVisible());
      allow create: if isOwnerCreate() || isAdmin();
      allow update, delete: if canWriteEntity();
    }

    match /xx_risk_actions/{id} {
      allow read: if isSignedIn() && (canReadEntity() || isTeamVisible());
      allow create: if canWriteResource();
      allow update, delete: if canWriteEntity();
    }

    match /xx_links/{id} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.createdBy == request.auth.uid
        || resource.data.ownerId == request.auth.uid
      );
      allow create: if isSignedIn() && (
        isAdmin()
        || request.resource.data.createdBy == request.auth.uid
        || request.resource.data.ownerId == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        isAdmin()
        || resource.data.createdBy == request.auth.uid
        || resource.data.ownerId == request.auth.uid
      );
    }

    match /xx_canvas_layout/{id} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.userId == request.auth.uid
        || resource.data.ownerId == request.auth.uid
      );
      allow create: if isSignedIn() && (
        isAdmin()
        || request.resource.data.userId == request.auth.uid
        || request.resource.data.ownerId == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        isAdmin()
        || resource.data.userId == request.auth.uid
        || resource.data.ownerId == request.auth.uid
      );
    }

    // Conversations IA : propriétaire uniquement, pas de mémoire croisée.
    match /xx_ai_threads/{id} {
      allow read, update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    // Préférences utilisateur / admin (ex. aiExternalEnabled).
    match /xx_settings/{id} {
      allow read: if isSignedIn() && (
        resource.id == request.auth.uid
        || resource.data.userId == request.auth.uid
        || isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.id == request.auth.uid
        || request.resource.data.userId == request.auth.uid
        || isAdmin()
      );
      allow update, delete: if isSignedIn() && (
        resource.id == request.auth.uid
        || resource.data.userId == request.auth.uid
        || isAdmin()
      );
    }

    match /xx_messages/{id} {
      allow read: if isSignedIn() && (
        isAdmin()
        || (resource.data.keys().hasAll(['memberIds'])
            && request.auth.uid in resource.data.memberIds)
        || (resource.data.keys().hasAll(['groupId'])
            && exists(/databases/$(database)/documents/xx_groups/$(resource.data.groupId))
            && (
              get(/databases/$(database)/documents/xx_groups/$(resource.data.groupId)).data.isGeneral == true
              || request.auth.uid in get(/databases/$(database)/documents/xx_groups/$(resource.data.groupId)).data.memberIds
            ))
      );
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasAll(['groupId', 'body'])
        && exists(/databases/$(database)/documents/xx_groups/$(request.resource.data.groupId))
        && (
          get(/databases/$(database)/documents/xx_groups/$(request.resource.data.groupId)).data.isGeneral == true
          || request.auth.uid in get(/databases/$(database)/documents/xx_groups/$(request.resource.data.groupId)).data.memberIds
        );
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.authorId == request.auth.uid);
    }
  }
}
