rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Demo client-only : Auth + sessions custom. Pour la prod, restreindre
    // par request.auth.uid et par collection (xx_users, xx_sessions, …).
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
