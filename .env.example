# Copiez ce fichier vers .env et renseignez les valeurs
# depuis Firebase Console → Paramètres du projet → Vos applications → SDK.
# Laissez vide pour rester en mode local (localStorage).
#
# Après remplissage : activer Authentication → E-mail/mot de passe,
# créer Firestore, puis redémarrer Vite (npm run dev).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Function Firebase `ai` (projet partagio, région us-central1).
# Production (Vercel/Netlify = front statique) : obligatoire.
# Local Vite : laisser vide pour rester sur POST /api/ai relatif.
VITE_AI_URL=https://us-central1-partagio.cloudfunctions.net/ai

# ---------------------------------------------------------------------------
# OpenAI — SERVEUR FIREBASE UNIQUEMENT (jamais dans le bundle frontend)
# Ne jamais préfixer VITE_ : ces clés ne doivent pas aller dans le client.
# Vercel n’est PAS le backend : ne pas y mettre OPENAI_API_KEY comme serveur produit.
# ---------------------------------------------------------------------------
# Local (Vite dev / preview) : OPENAI_API_KEY dans ce fichier .env.
# Production : secret Cloud Functions
#   firebase functions:secrets:set OPENAI_API_KEY
# Sans OPENAI_API_KEY, l’assistant affiche « OpenAI indisponible » et replie en local.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROK_API_KEY=

# Origines CORS extra (virgules), si domaine custom en plus de
# partagio.web.app / *.vercel.app / *.netlify.app
# NAZIX_CORS_ORIGINS=https://exemple.fr
