# Copiez ce fichier vers .env et renseignez les valeurs
# depuis Firebase Console → Paramètres du projet → Vos applications → SDK.
# Laissez vide pour rester en mode local (localStorage).
#
# Après remplissage : activer Authentication → E-mail/mot de passe,
# créer Firestore, puis redémarrer Vite (npm run dev).

VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# URL de la Cloud Function `ai` en production. Local Vite : laisser vide.
VITE_AI_URL=

# Administrateur optionnel (seed local). Laisser le mot de passe vide pour ne rien créer.
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=
# VITE_ADMIN_EMAIL_2=
# VITE_ADMIN_PASSWORD_2=
# VITE_ADMIN_EMAILS=

# Clé LLM — SERVEUR UNIQUEMENT (jamais de préfixe VITE_).
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROK_API_KEY=

# Origines CORS extra (virgules)
# NAZIX_CORS_ORIGINS=https://example.com
